# Environment Variables Example
# Copy this file to .env and fill in your actual values

# MongoDB Configuration (for sacred-experiment)
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password

# GitHub API Configuration (for ppbm examples)
GITHUB_USERNAME=your_github_username
GITHUB_PASSWORD=your_github_token

# Redis Configuration (for redline data examples)
REDIS_AUTH=your_redis_password

# AMQP Configuration (for message queue examples)
AMQP_ROUTING_KEY=think-bayes
